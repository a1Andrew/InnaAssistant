# InnaAssistant — ключі й доступи. Скопіюй у .env і заповни.

ANTHROPIC_API_KEY=sk-ant-...

# Окремий бот з @BotFather (не той самий токен, що в інших ботів!)
ASSISTANT_BOT_TOKEN=

# Чия це база: усі записи лягають під цей ID
ASSISTANT_OWNER_ID=595153958

# Хто може писати боту (через пробіл або кому): вона + адмін
ASSISTANT_USER_IDS=595153958

ASSISTANT_MODEL=claude-opus-5
ASSISTANT_TZ=Europe/Kyiv

# Розклад (локальний час)
MORNING_AT=08:30     # план на день
EVENING_AT=21:00     # підсумок дня
WEEKLY_AT=19:00      # аналіз тижня (неділя)
MONTHLY_AT=10:00     # зріз місяця (1-ше число)

# Тонке налаштування (можна не чіпати)
# MAX_HISTORY=30
# ASSISTANT_MAX_STEPS=14
